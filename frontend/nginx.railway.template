# Only the web service receives a Railway public domain. Edge terminates HTTPS.
server {
  listen ${PORT} default_server;
  listen [::]:${PORT} default_server;
  server_name _;
  return 444;
}
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name ${PUBLIC_HOST} healthcheck.railway.app;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 9m;
  client_body_timeout 30s;
  client_header_timeout 15s;
  send_timeout 30s;
  keepalive_timeout 30s;
  resolver ${DNS_RESOLVERS} valid=10s;
  resolver_timeout 5s;
  set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
  location ~ ^/(api/|ready$) {
    proxy_pass $api_upstream;
    proxy_set_header Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Proto https;
    # Never accept a caller-supplied forwarding chain. The edge address is the
    # conservative rate-limit identity until a verified edge-IP policy is installed.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 30s;
  }
  location / { try_files $uri /index.html; }
}
